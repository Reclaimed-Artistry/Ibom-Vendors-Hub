# ---------------------------------------------------------------
# Ibom Vendors Hub — environment
# ---------------------------------------------------------------

# Public site URL (no trailing slash). Root domain used for subdomains.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain that vendor subdomains hang off, e.g. ibomvendorshub.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Secret used to sign session cookies (min 32 chars). Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# PostgreSQL connection string.
# Production (Supabase): postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local development: postgres://postgres@127.0.0.1:5544/postgres  (started by `npm run dev:db`)
DATABASE_URL=postgres://postgres@127.0.0.1:5544/postgres
DATABASE_SSL=false

# --- Payments (optional in development) ---
# Without Paystack keys the platform runs a clearly-labelled sandbox gateway
# that still performs server-side verification of every payment record.
# The SECRET key is what initialises and verifies a transaction — a public key
# on its own cannot charge anyone (this app redirects to Paystack's hosted
# checkout, it does not use the inline popup). Keep test/live pairs together.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Transactional email (optional in development) ---
# Without a Resend key, emails are rendered and stored in email_logs (visible in
# the admin > Emails screen) so flows remain testable.
RESEND_API_KEY=
EMAIL_FROM="Ibom Vendors Hub <noreply@ibomvendorshub.com>"

# --- Google sign-in (optional) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console and
# add the redirect URI <NEXT_PUBLIC_APP_URL>/auth/google/callback as an authorised
# redirect URI. Leave both blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the computed callback URL
# GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback

# --- Scheduled jobs ---
CRON_SECRET=local-cron-secret

# --- Supabase (optional: storage + auth provider) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=storefronts

# Show verification/reset links in the UI when no email provider is configured.
NEXT_PUBLIC_DEV_EMAIL_LINKS=true
# Shows the seeded demo logins on /login. Leave unset in production.
DEMO_MODE=1

# --- First administrator (used once by `npm run db:bootstrap-admin` / Vercel build) ---
# On a fresh database these create the platform super admin. Existing admins are
# never overwritten, so it is safe to leave them set on later deploys.
ADMIN_EMAIL=
ADMIN_PASSWORD=
