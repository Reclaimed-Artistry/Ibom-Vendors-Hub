{
  "name": "ibom-vendors-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Ibom Vendors Hub - multi-vendor e-commerce SaaS platform with per-vendor subdomain storefronts",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:smoke": "tsx scripts/test-smoke.ts",
    "test": "npm run typecheck && npm run test:db",
    "vercel-build": "tsx scripts/migrate.ts && tsx scripts/bootstrap-admin.ts && next build",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "brand:assets": "tsx scripts/make-brand.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.545.0",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
